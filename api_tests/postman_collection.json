       ]
      },
      "description": ""
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "pm.test('200',()=>pm.response.to.have.status(200));",
         "pm.test('3 dominios',()=>pm.expect(Object.keys(pm.response.json().domains)).to.have.members(['infrastructure','data-governance','architecture']));"
